 "suites": {
  "contracts": {
   "cmd": "for f in schemas independence save_compat economy telemetry; do node tools/contracts/t_contract_$f.js || exit 1; done",
   "tier": "required",
   "categories": [
    "guardados",
    "economia"
   ]
  },
  "server": {
   "cmd": "cd server && npm ci && npm test",
   "tier": "required",
   "categories": [
    "guardados",
    "economia",
    "multijugador_simulado"
   ],
   "note": "incluye test-relay.js (relay en proceso, sin red) y test-item-economy*.js"
  },
  "pixel-density": {
   "cmd": "node tools/art/pixel-density.js --strict",
   "tier": "informational",
   "categories": [
    "sprites_atlas"
   ],
   "reason": "docs/ART_BIBLE.md §14 lo define informativo; hoy falla solo por assets/sprites/arenas/world-v1 sin excepción firmada (decisión D-24 del director)",
   "issue": "D-24"
  },
  "relay-externo": {
   "cmd": "node tools/release/relay-smoke.js --url wss://... (contra un relay real)",
   "tier": "external",
   "categories": [
    "multijugador_simulado"
   ],
   "reason": "requiere un relay accesible; lo administra el socio técnico"
  },
  "postgres": {
   "cmd": "cd server && HORDA_TEST_PG_URL=... node test-postgres.js",
   "tier": "external",
   "categories": [
    "guardados"
   ],
   "reason": "requiere una base PostgreSQL de prueba"
  }
 },
 "tolerated": {
  "integracion-pruebas.yml::Golems del nigromante (t_nigro_golems)": {
