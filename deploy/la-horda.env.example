# PLANTILLA del archivo de entorno del servidor de Fondal: se copia a /etc/la-horda/la-horda.env (FUERA del repositorio).
# NUNCA pongas credenciales reales en ESTE archivo (está en Git). En el servidor:
#   sudo install -d -m 750 -o root -g lahorda /etc/la-horda
#   sudo install -m 640 -o root -g lahorda deploy/la-horda.env.example /etc/la-horda/la-horda.env
#   sudo nano /etc/la-horda/la-horda.env        <- ahí sí van las claves
# Formato: una variable por línea, NOMBRE=valor, sin espacios alrededor del "=" y sin comillas (salvo que el valor tenga espacios).
# Guía: docs/commercial/DESPLIEGUE_FONDAL.md · Mercado Pago: docs/commercial/MERCADO_PAGO_PASO_A_PASO.md
# Chequeo de todo junto:  node tools/release/preflight.js --env-file /etc/la-horda/la-horda.env

# =====================================================================================
# A. DÓNDE ESCUCHA EL SERVIDOR Y QUIÉN PUEDE USARLO
# =====================================================================================
PORT=8787
# Escucha solo en este mismo servidor (nginx/Apache le habla por dentro). No lo cambies si usás proxy.
HOST=127.0.0.1
# 1 = detrás de nginx/Apache: lee la IP real del jugador (de X-Forwarded-For, que el proxy de deploy/ pisa con la IP verdadera).
# Sin esto TODOS los jugadores parecen una sola IP y comparten los frenos de abuso (8 contraseñas mal = nadie entra).
TRUST_PROXY=1
# Páginas desde las que se puede usar el servidor (separadas por coma, sin barra final). Es el ORIGEN de la página del juego.
ALLOWED_ORIGINS=https://fondalstudios.com
# 1 = usar SOLO la lista de arriba. Sin esto el servidor además acepta GitHub Pages y raw.githack.com (que sirve páginas de
# cualquier repositorio). En producción propia: 1.
ALLOWED_ORIGINS_STRICT=1
# 1 = si no hay base persistente, las cuentas NO arrancan (es lo correcto antes de cobrar).
REQUIRE_PERSISTENT_ACCOUNTS=1

# =====================================================================================
# B. BASE DE DATOS (obligatoria para cobrar)
# =====================================================================================
# Postgres. Ej.: postgresql://usuario:CLAVE@127.0.0.1:5432/lahorda   (si la base vive en el mismo servidor, 127.0.0.1)
# Si la base es de un servicio externo (Neon, Render...) pegá su dirección completa (termina en ?sslmode=require). SECRETO.
DATABASE_URL=
# Solo para la copia de seguridad: 1 = guarda únicamente las tablas horda_* (si la base se comparte con otra app). 0 = toda la base.
BACKUP_ONLY_HORDA=1

# =====================================================================================
# C. CONSTRUCCIÓN DEL SITIO (las lee deploy/update.sh; el servidor del juego las ignora)
# =====================================================================================
# Dirección pública del servidor de salas que usa el juego. Misma dirección que sirve nginx (sección 5 de la guía).
# Opción "todo en una ruta" (recomendada para empezar):  wss://fondalstudios.com/la-horda/red
# Opción "subdominio":                                   wss://red.fondalstudios.com
GAME_RELAY_URL=wss://fondalstudios.com/la-horda/red
# Dirección pública de la página del juego (con barra final): se usa en metadatos y vista previa al compartir.
GAME_SITE_URL=https://fondalstudios.com/la-horda/jugar/
# 1 = junta los ~450 scripts en ~25 pedidos y activa el caché por hash (carga mucho más rápida). Recomendado.
GAME_PERF=1

# =====================================================================================
# D. ADMINISTRACIÓN (dejar COMO ESTÁ salvo que la guía diga otra cosa)
# =====================================================================================
# NO crear ADMIN_USERS ni FOUNDERS_JSON: pisan la configuración de server/operator-config.json.
# FOUNDER_SIGNUP_CODE: solo para crear UNA vez la cuenta FacuGM (docs/founders/OPERACION.md); después BORRARLA.

# =====================================================================================
# E. PAGOS — Mercado Pago (apagado por defecto). Detalle de cada variable en server/launch.env.example
# =====================================================================================
# INTERRUPTOR GENERAL. 0 = la tienda dice "Muy pronto". Se pone en 1 SOLO al terminar docs/commercial/CHECKLIST_ULTIMA_PRUEBA.md.
# Apagado de emergencia: MP_ENABLED=0 y  sudo systemctl restart la-horda  (los pagos ya hechos se siguen acreditando por el webhook).
MP_ENABLED=0
PAYMENTS_PROVIDER=mercadopago
# sandbox = credenciales de PRUEBA (no se mueve plata)  |  live = credenciales de PRODUCCIÓN (plata real)
MP_MODE=sandbox
# Access Token (Tus integraciones > Credenciales). SECRETO.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta de Webhooks (mínimo 32 caracteres). SECRETO.
MP_WEBHOOK_SECRET=
# Número de usuario (Collector ID) de la cuenta vendedora. Solo dígitos.
MP_COLLECTOR_ID=
# Secreto propio para firmar pedidos: openssl rand -hex 32. No lo rotes con pagos pendientes. SECRETO.
PAYMENTS_ORDER_SECRET=
# Pesos por dólar (Mercado Pago cobra en ARS). Revisalo seguido.
MP_ARS_PER_USD=
# URLs públicas (HTTPS). Tienen que apuntar al servidor de salas/cuentas tal como lo expone nginx:
#   con la opción "ruta":      https://fondalstudios.com/la-horda/red/api/payments/webhook
#   con la opción "subdominio": https://red.fondalstudios.com/api/payments/webhook
PAYMENTS_NOTIFY_URL=https://fondalstudios.com/la-horda/red/api/payments/webhook
PAYMENTS_SUCCESS_URL=https://fondalstudios.com/la-horda/jugar/
PAYMENTS_PACK_IDS=brasas_inicio,brasas_coleccion
MP_REQUIRE_EMAIL=1

# =====================================================================================
# F. SOLO SI NO USÁS POSTGRES (no recomendado para cobrar)
# =====================================================================================
# DATA_DIR ya lo pone la unidad systemd (/var/lib/la-horda). DATA_PERSISTENT=1 declara que ese disco se respalda y sobrevive.
DATA_PERSISTENT=0
