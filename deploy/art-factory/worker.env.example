# A dedicated worker host; not the player's phone or the live accounts process.
FONDAL_ART_API=https://fondalstudios.com/la-horda/red
# Generate privately; same value on the relay. Never commit a real token.
FONDAL_ART_WORKER_TOKEN=
FONDAL_ART_OUTPUT=/var/lib/fondal-art
# Optional until a local model is installed and qualified. Without this, authored
# native recipes work; free-description jobs report BLOCKED_MODEL honestly.
# FONDAL_ART_PROFILE=/etc/fondal-art/model-profile.json
FONDAL_COMFY_URL=http://127.0.0.1:8188
# Runway alternative: copy runway-s0f.example.json outside the repository, review
# the spending ceilings and set enabled=true ONLY with the owner's authorization.
# FONDAL_ART_PROFILE=/etc/fondal-art/runway-s0f.json
# RUNWAYML_API_SECRET=             # secret in worker runtime; never browser/repository
# RUNWAY_API_KEY=                 # supported alias, use only one
# Each worker root owns one shared ledger/cache, across all champions/jobs.
# Do not run independent roots if they must share one daily budget.
# Use this SAME absolute path for CLI and worker; all spending/cache journals share it.
# FONDAL_SPEND_LEDGER=/var/lib/fondal-art/spend-ledger.json
