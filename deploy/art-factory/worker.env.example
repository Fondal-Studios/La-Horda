# A dedicated worker host; not the player's phone or the live accounts process.
FONDAL_ART_API=https://fondalstudios.com/la-horda/red
# Generate privately; same value on the relay. Never commit a real token.
FONDAL_ART_WORKER_TOKEN=
FONDAL_ART_OUTPUT=/var/lib/fondal-art
# Optional until a local model is installed and qualified. Without this, authored
# native recipes work; free-description jobs report BLOCKED_MODEL honestly.
# FONDAL_ART_PROFILE=/etc/fondal-art/model-profile.json
FONDAL_COMFY_URL=http://127.0.0.1:8188
