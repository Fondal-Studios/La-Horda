{
  "$id": "fondal/la-horda/EconomyTransaction/1.0.0",
  "title": "EconomyTransaction",
  "type": "object",
  "required": ["contract", "version", "txId", "accountId", "kind", "currency", "amount", "source", "actor", "at"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "EconomyTransaction" },
    "version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "txId": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{8,80}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{8,80}$" },
    "accountId": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,64}$" },
    "kind": { "enum": ["credit", "debit", "refund", "adjust"] },
    "currency": { "enum": ["gold", "materials", "brasas"] },
    "amount": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
    "balanceAfter": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "source": { "enum": ["run_reward", "chest", "reward_claim", "sale", "shop_purchase", "payment", "gm_adjust", "refund", "migration"] },
    "evidenceRef": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{8,80}$" },
    "actor": { "enum": ["server", "user", "admin"] },
    "at": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "maxLength": 120 }
  }
}
