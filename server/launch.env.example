# Configuration TEMPLATE, never put real credentials in this tracked file.
# Keep payments disabled until docs/commercial/LAUNCH.md gates pass.
PAYMENTS_PROVIDER=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PAYMENTS_ORDER_SECRET=
MP_COLLECTOR_ID=
MP_LIVE_MODE=false
# Commercial proposal: repeatable cosmetic-only packs, no one-time purchases.
PAYMENTS_PACK_IDS=brasas_inicio,brasas_coleccion
MP_ARS_PER_USD=
PAYMENTS_NOTIFY_URL=https://fondalstudios.com/la-horda/red/api/payments/webhook
PAYMENTS_SUCCESS_URL=https://fondalstudios.com/la-horda/jugar/
# Prefer DATABASE_URL. For an existing persistent volume use DATA_DIR and verify a restore.
DATABASE_URL=
DATA_DIR=
# Do not set this to 1 just to silence the warning. Verify the mounted storage first.
DATA_PERSISTENT=0
