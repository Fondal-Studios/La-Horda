# PLANTILLA de configuración. NUNCA pongas credenciales reales en este archivo (está en Git).
# Estas variables se cargan en el SERVIDOR (panel del hosting / archivo .env fuera del repo).
# Guía paso a paso: docs/commercial/MERCADO_PAGO_PASO_A_PASO.md  ·  Chequeo: node tools/release/mp-readiness.js

# ---- INTERRUPTOR GENERAL (apagado por defecto) ----
# 1 = se puede comprar Brasas con Mercado Pago. Cualquier otra cosa = tienda en "Muy pronto".
# Apagado de emergencia: poner MP_ENABLED=0 y reiniciar. Los pagos ya hechos se siguen acreditando por el webhook.
MP_ENABLED=0

# ---- Mercado Pago ----
PAYMENTS_PROVIDER=mercadopago
# sandbox = credenciales de PRUEBA (no se mueve plata)  |  live = credenciales de PRODUCCIÓN (plata real)
MP_MODE=sandbox
# Access Token del servidor (Tus integraciones > Credenciales). Empieza con APP_USR- o TEST-. Secreto.
MP_ACCESS_TOKEN=
# Public Key: HOY EL CÓDIGO NO LA USA (Checkout Pro redirige a Mercado Pago). Se guarda acá solo por si más adelante se usa un botón embebido.
MP_PUBLIC_KEY=
# Clave secreta de Webhooks (Tus integraciones > Webhooks). Mínimo 32 caracteres. Secreto.
MP_WEBHOOK_SECRET=
# Número de usuario (Collector ID) de la cuenta vendedora. Solo dígitos. El servidor rechaza pagos de otra cuenta.
MP_COLLECTOR_ID=
# Secreto propio para firmar los pedidos. Generalo vos: openssl rand -hex 32. No lo rotes con pagos pendientes.
PAYMENTS_ORDER_SECRET=
# Pesos por cada dólar con que se convierten los precios (Mercado Pago cobra en ARS). Revisalo cada tanto. Ej: 1200
MP_ARS_PER_USD=
# URL pública del webhook (HTTPS). Tiene que ser la misma que cargues en Mercado Pago.
PAYMENTS_NOTIFY_URL=https://fondalstudios.com/la-horda/red/api/payments/webhook
# A dónde vuelve el jugador después de pagar (HTTPS). El regreso NUNCA acredita nada: acredita solo el webhook.
PAYMENTS_SUCCESS_URL=https://fondalstudios.com/la-horda/jugar/
# Packs a la venta (lista separada por comas). Vacío = los packs normales; "brasas_inicio,brasas_coleccion" = oferta de lanzamiento.
PAYMENTS_PACK_IDS=brasas_inicio,brasas_coleccion
# 1 (por defecto) = exige que la cuenta tenga un correo cargado para comprar. 0 = no lo exige.
MP_REQUIRE_EMAIL=1

# Compatibilidad: si no definís MP_MODE, se usa MP_LIVE_MODE=true|false.
# MP_LIVE_MODE=false
# Solo para ensayos locales con el servidor falso (tools/release/mp-readiness.js). Se IGNORA en modo live. No lo uses en el servidor real.
# MP_API_BASE=

# ---- Almacenamiento (obligatorio para cobrar: sin base persistente el servidor se niega a cobrar) ----
# Preferido: DATABASE_URL. Si usás un volumen: DATA_DIR + DATA_PERSISTENT=1 SOLO después de verificar que el volumen sobrevive y restaura.
DATABASE_URL=
DATA_DIR=
DATA_PERSISTENT=0
